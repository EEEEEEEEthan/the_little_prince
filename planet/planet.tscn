[sub_resource type="GDScript" id="GDScript_planet"]
script/source = "extends Node2D
## 可复用 2D 圆弧星球：Body / Surface / Sky / Clouds 统一绕球心旋转。
## 用法：改半径、贴图、自转等参数；地物拖到 Surface 下即可。
## Body 贴图按显示直径原尺寸绘制，不使用 scale。
## 小王子视觉上始终停在弧顶，实际由地表与星空反向旋转模拟行走。

@export var radius: float = WorldConstants.PLANET_RADIUS:
	set(value):
		radius = value

## 觐见禁区半宽；0 表示不限制。
@export var audience_keep_away_arc: float = 0.0

## 当前玩家角（弧顶处的地表角度），是旋转状态的唯一来源。
var player_angle: float = 0.0
## 出生角固定为 0：星球本地 y 最小处（未旋转时的弧顶）。
var spawn_angle: float = 0.0
var has_contacted_audience_keep_away: bool = false
## 地表地物数据（静态场景内收集，供测试断言）。
var rose_angle: float = 0.0
var king_angle: float = 0.0
var volcano_angles: Array[float] = []
var baobab_angles: Array[float] = []
var flora_angles: Array[float] = []
var surface_props: Array[SurfaceProp] = []
var overlapping_player_triggers: Array[Area2D] = []
var focused_player_trigger: Area2D

## 当前角速度（弧度/秒），经阻尼向目标速度平滑逼近。正值表示向右走。
var angular_velocity: float = 0.0
var is_interact_holding: bool:
	get:
		return focused_player_trigger != null and focused_player_trigger.is_holding

@onready var body: Sprite2D = %Body
@onready var surface: Node2D = %Surface
@onready var sky = %Sky
@onready var clouds = %Clouds


func _ready() -> void:
	_collect_surface_props()


func _collect_surface_props() -> void:
	for child in surface.get_children():
		if child.name == \"Rose\":
			rose_angle = child.rotation
		elif child.name == \"King\":
			king_angle = child.rotation
		elif child.name.begins_with(\"Volcano\"):
			volcano_angles.append(child.rotation)
		elif child.name.begins_with(\"Baobab\"):
			baobab_angles.append(child.rotation)
		elif child.name.begins_with(\"Flora\"):
			flora_angles.append(child.rotation)
		var prop := child as SurfaceProp
		if prop == null:
			continue
		surface_props.append(prop)


func bind_player_footprint(footprint: Area2D) -> void:
	footprint.area_entered.connect(_on_player_entered_area)
	footprint.area_exited.connect(_on_player_exited_area)


func is_player_in_grass() -> bool:
	for area in overlapping_player_triggers:
		if area.is_in_group(&\"grass\"):
			return true
	return false


func _on_player_entered_area(area: Area2D) -> void:
	if not area.has_method(\"hosted_surface_prop\"):
		return
	overlapping_player_triggers.append(area)
	area.notify_player_entered()
	refresh_interact_focus()


func _on_player_exited_area(area: Area2D) -> void:
	overlapping_player_triggers.erase(area)
	if area.has_method(\"notify_player_exited\"):
		area.notify_player_exited()
	refresh_interact_focus()


func refresh_interact_focus() -> void:
	var story := get_node(\"%Story\") as PlanetStory
	var best: Area2D = null
	var best_distance_squared := INF
	if story.is_active and not story.is_blocking_input:
		for area in overlapping_player_triggers:
			if not area.is_armed or area.interact_kind == WorldConstants.InteractKind.NONE:
				continue
			var prop := area.hosted_surface_prop() as SurfaceProp
			if prop == null or not story.accepts_interact(prop):
				continue
			var distance_squared := apex_global_position().distance_squared_to(area.global_position)
			if distance_squared <= best_distance_squared:
				best_distance_squared = distance_squared
				best = area
	if focused_player_trigger == best:
		return
	if focused_player_trigger != null:
		focused_player_trigger.is_focused = false
	focused_player_trigger = best
	if focused_player_trigger != null:
		focused_player_trigger.is_focused = true


func apex_global_position() -> Vector2:
	return global_position + Vector2(0.0, -radius)


func is_moving() -> bool:
	return absf(angular_velocity) > 0.02


## 玩家沿线移动 direction 方向，角速度带阻尼平滑逼近目标，驱动星球反向旋转。
func move_player(direction: float, delta: float) -> void:
	var max_angular_speed := WorldConstants.PLAYER_SPEED / radius
	var target_velocity := direction * max_angular_speed
	var smoothing := 1.0 - exp(-WorldConstants.PLAYER_DAMPING * delta)
	angular_velocity = lerp(angular_velocity, target_velocity, smoothing)
	var next_angle := fposmod(player_angle + angular_velocity * delta, TAU)
	if audience_keep_away_arc > 0.0:
		var current_offset := angle_difference(king_angle, player_angle)
		var next_offset := angle_difference(king_angle, next_angle)
		if absf(next_offset) < audience_keep_away_arc:
			var keep_away_side := current_offset
			if is_zero_approx(keep_away_side):
				keep_away_side = 1.0 if angular_velocity >= 0.0 else -1.0
			has_contacted_audience_keep_away = true
			angular_velocity = 0.0
			next_angle = fposmod(
					king_angle + signf(keep_away_side) * audience_keep_away_arc,
					TAU
			)
	player_angle = next_angle
	_sync_rotation()


func teleport_player(angle: float) -> void:
	angular_velocity = 0.0
	player_angle = fposmod(angle, TAU)
	_sync_rotation()


func is_king_visible_from_player() -> bool:
	return (
			absf(angle_difference(player_angle, king_angle))
			<= WorldConstants.VISIBLE_HALF_ARC
	)


func is_in_distant_king_voice_range() -> bool:
	var distance_from_king := absf(angle_difference(player_angle, king_angle))
	return (
			distance_from_king <= WorldConstants.KING_DISTANT_VOICE_ARC
			and not is_king_visible_from_player()
	)


func signed_angle_from_king() -> float:
	return angle_difference(king_angle, player_angle)


func _sync_rotation() -> void:
	var rotation_value := -player_angle
	body.rotation = rotation_value
	surface.rotation = rotation_value
	sky.set_planet_rotation(rotation_value)
	clouds.set_planet_rotation(rotation_value)
"

[sub_resource type="Shader" id="Shader_sky"]
code = "shader_type canvas_item;
// 统一天空 shader：按天空相位从 zenith_gradient 采样背景色，
// 星空走 Sprite 自身 TEXTURE（starfield.png），夜空渐变控制星星透明度。

uniform sampler2D zenith_gradient : filter_nearest;
uniform sampler2D star_alpha_gradient : hint_default_white, filter_nearest;
uniform sampler2D noise_texture : hint_default_white, filter_nearest;
// phase: 0=午夜, 0.25=日出, 0.5=正午, 0.75=日落, 1=午夜
uniform float phase : hint_range(0.0, 1.0) = 0.5;
uniform float noise_strength : hint_range(0.0, 0.1) = 0.02;

void fragment() {
	// 量化到噪声纹理像素后取样，噪声附着在像素上而不是随帧跳动。
	vec2 noise_size = vec2(textureSize(noise_texture, 0));
	vec2 noise_uv = (floor(UV * noise_size) + 0.5) / max(noise_size, vec2(1.0));
	float pixel_noise = (texture(noise_texture, noise_uv).r - 0.5) * noise_strength;
	vec3 sky_color = texture(zenith_gradient, vec2(clamp(phase + pixel_noise, 0.0, 1.0), 0.5)).rgb;
	vec4 stars = texture(TEXTURE, UV);
	float star_alpha = texture(star_alpha_gradient, vec2(phase, 0.5)).r;
	vec3 final_color = mix(sky_color, stars.rgb, stars.a * star_alpha);
	COLOR = vec4(final_color, 1.0);
}
"

