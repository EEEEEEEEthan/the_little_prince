[sub_resource type="GDScript" id="GDScript_footstep"]
script/source = "extends AudioStreamPlayer
## 行走落地 one-shot：默认土地；进草丛 Area 后改播草地。

const META_DIRT_FOOTSTEP_A := \"dirt_footstep_a\"
const META_DIRT_FOOTSTEP_B := \"dirt_footstep_b\"
const META_GRASS_FOOTSTEP_A := \"grass_footstep_a\"
const META_GRASS_FOOTSTEP_B := \"grass_footstep_b\"

var played_step_count: int = 0
var last_step_was_grass: bool = false


func play_step() -> void:
	var variant_is_first := (played_step_count % 2) == 0
	played_step_count += 1
	var use_grass := (%Player as Player).is_in_grass()
	var meta_name: String
	if use_grass:
		meta_name = META_GRASS_FOOTSTEP_A if variant_is_first else META_GRASS_FOOTSTEP_B
	else:
		meta_name = META_DIRT_FOOTSTEP_A if variant_is_first else META_DIRT_FOOTSTEP_B
	stream = owner.get_node(\"Config\").get_meta(meta_name) as AudioStream
	last_step_was_grass = use_grass
	play()
"

[sub_resource type="GDScript" id="GDScript_music"]
script/source = "extends Node
## 循环配乐：故乡、国王、酒鬼、商人、点灯人、地理学家星球，交叉淡化切换。

const META_HOME_DAY_MUSIC := \"home_day_music\"
const META_KING_DAY_MUSIC := \"king_day_music\"
const META_DRUNKARD_DAY_MUSIC := \"drunkard_day_music\"
const META_MERCHANT_DAY_MUSIC := \"merchant_day_music\"
const META_LAMPLIGHTER_DAY_MUSIC := \"lamplighter_day_music\"
const META_GEOGRAPHER_DAY_MUSIC := \"geographer_day_music\"
const META_OPENING_DAY_MUSIC := \"opening_day_music\"
const CROSSFADE_SECONDS := 1.6
const PLAYING_VOLUME_DB := -10.0
const SILENT_VOLUME_DB := -80.0

var playing_stream: AudioStream:
	get:
		return _active.stream

var _active: AudioStreamPlayer
var _idle: AudioStreamPlayer
var _fade_tween: Tween


func _ready() -> void:
	_active = $Playing
	_idle = $Incoming
	for meta_name in [META_HOME_DAY_MUSIC, META_KING_DAY_MUSIC]:
		(_config_music(meta_name) as AudioStreamOggVorbis).loop = true
	var config := owner.get_node(\"Config\")
	if config.has_meta(META_DRUNKARD_DAY_MUSIC):
		(_config_music(META_DRUNKARD_DAY_MUSIC) as AudioStreamOggVorbis).loop = true
	if config.has_meta(META_MERCHANT_DAY_MUSIC):
		(_config_music(META_MERCHANT_DAY_MUSIC) as AudioStreamOggVorbis).loop = true
	if config.has_meta(META_LAMPLIGHTER_DAY_MUSIC):
		(_config_music(META_LAMPLIGHTER_DAY_MUSIC) as AudioStreamOggVorbis).loop = true
	if config.has_meta(META_GEOGRAPHER_DAY_MUSIC):
		(_config_music(META_GEOGRAPHER_DAY_MUSIC) as AudioStreamOggVorbis).loop = true
	_active.volume_db = SILENT_VOLUME_DB
	_idle.volume_db = SILENT_VOLUME_DB
	_active.stream = _opening_music()
	_active.play()
	_fade_tween = create_tween()
	_fade_tween.tween_property(_active, \"volume_db\", PLAYING_VOLUME_DB, CROSSFADE_SECONDS)


func play_king_day_loop() -> void:
	_crossfade_to(_config_music(META_KING_DAY_MUSIC))


func play_drunkard_day_loop() -> void:
	_crossfade_to(_config_music(META_DRUNKARD_DAY_MUSIC))


func play_merchant_day_loop() -> void:
	_crossfade_to(_config_music(META_MERCHANT_DAY_MUSIC))


func play_lamplighter_day_loop() -> void:
	_crossfade_to(_config_music(META_LAMPLIGHTER_DAY_MUSIC))


func play_geographer_day_loop() -> void:
	_crossfade_to(_config_music(META_GEOGRAPHER_DAY_MUSIC))


func fade_out() -> void:
	_crossfade_to(null)


func _opening_music() -> AudioStream:
	var config := owner.get_node(\"Config\")
	if config.has_meta(META_OPENING_DAY_MUSIC):
		var opening := config.get_meta(META_OPENING_DAY_MUSIC) as AudioStream
		var vorbis := opening as AudioStreamOggVorbis
		if vorbis != null:
			vorbis.loop = true
		return opening
	return _config_music(META_HOME_DAY_MUSIC)


func _crossfade_to(music: AudioStream) -> void:
	if music != null and _active.stream == music and _active.playing:
		return
	if _fade_tween != null:
		_fade_tween.kill()
	var outgoing := _active
	var incoming := _idle
	_active = incoming
	_idle = outgoing
	incoming.stop()
	incoming.stream = music
	incoming.volume_db = SILENT_VOLUME_DB
	if music != null:
		incoming.play()
	_fade_tween = create_tween()
	_fade_tween.set_parallel(true)
	_fade_tween.tween_property(outgoing, \"volume_db\", SILENT_VOLUME_DB, CROSSFADE_SECONDS)
	if music != null:
		_fade_tween.tween_property(incoming, \"volume_db\", PLAYING_VOLUME_DB, CROSSFADE_SECONDS)
	_fade_tween.chain().tween_callback(outgoing.stop)


func _config_music(meta_name: String) -> AudioStream:
	return owner.get_node(\"Config\").get_meta(meta_name) as AudioStream
"

