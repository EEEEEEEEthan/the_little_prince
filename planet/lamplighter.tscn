[sub_resource type="GDScript" id="GDScript_lamp_duty"]
script/source = "extends Node
## 按昼夜点灭这一盏灯；帮点一次也不停。

func _process(_delta: float) -> void:
	var phase: float = (owner as Planet).sky.daylight_phase()
	%StreetLamp.frame = 1 if SkyPhase.is_night_phase(phase) else 0
"

