[gd_scene format=3 uid="uid://cplyrtrgscn1"]

[sub_resource type="GDScript" id="GDScript_player_trigger"]
script/source = "@tool
extends Area2D
## 玩家邻近检测。InteractKind 只描述按键方式；头顶 A 键由本节点自己显示。

signal player_entered
signal player_exited
signal interacted

@export var interact_kind: WorldConstants.InteractKind = WorldConstants.InteractKind.PRESS
@export var long_press_seconds: float = 0.8
@export var shape: Shape2D:
	set(value):
		shape = value
		if not is_node_ready():
			await ready
		%CollisionShape2D.shape = shape

var is_armed: bool = false
var is_holding: bool = false
var is_focused: bool = false:
	set(value):
		is_focused = value
		if not is_node_ready():
			await ready
		if is_focused:
			_show_prompt()
			set_process(true)
		else:
			_hide_prompt()
			set_process(false)

var _hold_elapsed_seconds: float = 0.0
var _player_is_inside: bool = false
var _prompt: Sprite2D


func hosted_surface_prop() -> SurfaceProp:
	return owner as SurfaceProp


func notify_player_entered() -> void:
	_player_is_inside = true
	player_entered.emit()


func notify_player_exited() -> void:
	_player_is_inside = false
	_clear_hold()
	player_exited.emit()


func _ready() -> void:
	set_process(false)


func _process(delta: float) -> void:
	if not is_focused:
		return
	_sync_prompt()
	if interact_kind == WorldConstants.InteractKind.NONE:
		return
	var required_hold_seconds := 0.0
	if interact_kind == WorldConstants.InteractKind.LONG_PRESS:
		required_hold_seconds = long_press_seconds
		var story := _planet_story()
		if story != null and story.skip_cinematics:
			required_hold_seconds = 0.0
	if required_hold_seconds > 0.0:
		if Input.is_action_pressed(&\"interact\"):
			if _hold_elapsed_seconds <= 0.0:
				_planet().angular_velocity = 0.0
			is_holding = true
			_hold_elapsed_seconds += delta
			_prompt.hold_fill_ratio = _hold_elapsed_seconds / required_hold_seconds
			if _hold_elapsed_seconds >= required_hold_seconds:
				_clear_hold()
				interacted.emit()
		else:
			_clear_hold()
		return
	_clear_hold()
	if Input.is_action_just_pressed(&\"interact\"):
		interacted.emit()


func _show_prompt() -> void:
	if not is_instance_valid(_prompt):
		_prompt = (%Prompt as InstancePlaceholder).create_instance() as Sprite2D
	_prompt.hold_fill_ratio = 0.0
	_sync_prompt()


func _hide_prompt() -> void:
	if is_instance_valid(_prompt):
		_prompt.queue_free()
		_prompt = null
	_clear_hold()


func _clear_hold() -> void:
	is_holding = false
	_hold_elapsed_seconds = 0.0
	if is_instance_valid(_prompt):
		_prompt.hold_fill_ratio = 0.0


func _sync_prompt() -> void:
	_prompt.global_position = to_global(Vector2(0.0, WorldConstants.INTERACT_PROMPT_LOCAL_Y))
	if _prompt.hold_fill_ratio > 0.0:
		_prompt.offset = Vector2.ZERO
	else:
		_prompt.offset = Vector2(0.0, sin(Time.get_ticks_msec() * 0.006) * 1.5)


func _planet() -> Node:
	var prop := hosted_surface_prop()
	if prop != null:
		return prop.owner
	return owner


func _planet_story() -> PlanetStory:
	return _planet().get_node(\"%Story\") as PlanetStory
"

[sub_resource type="CircleShape2D" id="CircleShape2D_trigger"]
radius = 6.0

[sub_resource type="Shader" id="Shader_prompt_fill"]
code = "shader_type canvas_item;
render_mode unshaded;

uniform float fill_ratio : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec4 texel = texture(TEXTURE, UV);
	vec2 from_center = UV * 2.0 - 1.0;
	float angle_turns = atan(-from_center.x, -from_center.y) / TAU + 0.5;
	float filled = step(angle_turns, fill_ratio);
	float holding = 1.0 - step(fill_ratio, 0.0);
	float brightness = mix(1.0, mix(0.35, 1.0, filled), holding);
	COLOR = vec4(texel.rgb * brightness, texel.a);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_cugj7"]
resource_local_to_scene = true
shader = SubResource("Shader_prompt_fill")
shader_parameter/fill_ratio = 0.0

