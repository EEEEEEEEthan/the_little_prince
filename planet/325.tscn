[sub_resource type="GDScript" id="GDScript_story"]
script/source = "extends PlanetStory
## 325 号小行星：背面降落，路上可点环境；觐见时对上现有国王对话（无日落）。

const KING_SPEAKER := \"国王\"
const MOUSE_SPEAKER := \"小老鼠\"

@export var king_portrait: Texture2D

var has_overheard_distant_sentencing: bool = false
var last_king_facing_order_text: String = \"\"
var _last_player_facing_king: bool = false
var _mouse_verdict_count := -1


func _prepare_start() -> void:
	player.move_speed_scale = 0.65
	player.modulate.a = 1.0
	has_overheard_distant_sentencing = false
	last_king_facing_order_text = \"\"
	_mouse_verdict_count = -1
	%Mouse.restore_at_rest()
	set_process(false)


func _ready() -> void:
	set_process(false)
	await super._ready()


func _play_story() -> void:
	await _fade_in_from_black()
	await _overhead(\"325\")
	player.can_move_left = true
	player.can_move_right = true
	is_blocking_input = false
	has_finished_opening = true
	_talk_with_mouse()
	await _await_king()


func accepts_interact(prop: SurfaceProp) -> bool:
	if not is_active or is_blocking_player_input() or prop.is_consumed:
		return false
	if not _waiting_props.is_empty():
		return _waiting_props.has(prop)
	return prop == %Mouse


func try_handle_interact(prop: SurfaceProp) -> bool:
	if not _waiting_props.is_empty() and _waiting_props.has(prop):
		return super.try_handle_interact(prop)
	if not accepts_interact(prop) or prop != %Mouse:
		return false
	_lock_input()
	return true


func _talk_with_mouse() -> void:
	var mouse_squeak_count := 0
	while true:
		await %Mouse.interacted
		if _mouse_verdict_count >= 0:
			if _mouse_verdict_count % 2 == 0:
				await _prince(\"我，B612星王子，325星大臣，代表325国王，宣判你死刑\")
			else:
				await _prince(\"我，B612星王子，325星大臣，代表325国王，赦免你的死罪\")
			_mouse_verdict_count += 1
			is_blocking_input = false
			continue
		if %Mouse.is_consumed:
			continue
		mouse_squeak_count += 1
		if mouse_squeak_count == 1:
			await _line(MOUSE_SPEAKER, \"吱~吱吱？\", null)
			await _prince(\"吱吱吱吱。\")
		elif mouse_squeak_count == 2:
			await _line(MOUSE_SPEAKER, \"吱吱吱？\", null)
			await _prince(\"吱吱吱！\")
		else:
			await _line(MOUSE_SPEAKER, \"吱吱！\", null)
			await _prince(\"喵~~~~~喵~~~！\")
			%Mouse.run_away()
			await _overhead(\"小老鼠跑掉了\")
		is_blocking_input = false


func _await_king() -> void:
	await %TriggerHello.player_entered
	_lock_input()
	await _king(\"啊，来了一个臣民\")
	await _overhead(\"小王子愣了一下\")
	await _king(\"靠近些，让我好好看看你。\")
	is_blocking_input = false
	await %TriggerSleepy.player_entered
	_last_player_facing_king = _player_is_facing_king()
	set_process(true)
	_lock_input()
	await _prince(\"陛下~~哈~哈~~啊~下\")
	await _overhead(\"小王子不小心打了个哈欠\")
	await _king(\"在一个国王面前打哈欠是违反礼节的。我禁止你打哈欠。\")
	await _prince(\"对不起，我实在忍不住。我长途跋涉来到这里，还没有睡觉呢。\")
	await _king(\"那好吧，我命令你打哈欠。好些年来我没有看见过任何人打哈欠。\")
	await _king(\"对于我来说，打哈欠倒是新奇的事。\")
	await _king(\"来吧，再打个哈欠！这是命令。\")
	await _prince(\"这让我有点紧张。。。我打不出来了。。。\")
	await _overhead(\"国王有点生气\")
	await _king(\"那我命令你忽而打哈欠，忽而不打哈欠！\")
	await _overhead(\"他是一位绝对的君主\")
	await _overhead(\"与此同时，他又是理智的\")
	is_blocking_input = false
	%TriggerSleepy.interact_kind = WorldConstants.InteractKind.PRESS
	%TriggerSleepy.is_armed = true
	planet.refresh_interact_focus()
	await %TriggerSleepy.interacted
	%TriggerSleepy.is_armed = false
	planet.refresh_interact_focus()
	_lock_input()
	await _prince(\"陛下...请原谅，我想问您...\")
	await _king(\"我命令你问我。\")
	await _prince(\"陛下...您统治什么？\")
	await _king(\"统治一切。\")
	await _prince(\"一切？\")
	await _king(\"一切。\")
	await _overhead(\"国王做了一个手势\")
	await _prince(\"所有的星星？\")
	await _king(\"所有的星星。\")
	await _overhead(\"他的统治是绝对的。\")
	await _prince(\"星星服从吗？\")
	await _king(\"当然，它们立刻服从。我不容许无纪律。\")
	await _overhead(\"这样的权力让小王子惊叹。\")
	is_blocking_input = false
	%TriggerSleepy.is_armed = true
	planet.refresh_interact_focus()
	await %TriggerSleepy.interacted
	%TriggerSleepy.is_armed = false
	planet.refresh_interact_focus()
	_lock_input()
	await _prince(\"我很想看一次日落...请给我这个恩惠...命令太阳下山...\")
	await _king(\"如果我命令一个将军变成一只蝴蝶或者一只鸟\")
	await _king(\"如果这个将军不执行的话，那么，是他不对还是我不对呢？\")
	await _prince(\"那当然是您的不对。\")
	await _king(\"一点也不错。\")
	await _king(\"像每个人提出的要求应该是他们所能做到的。\")
	await _king(\"权威首先应该建立在理性的基础上。\")
	await _king(\"如果命令...\")
	await _overhead(\"小王子有点走神\")
	is_blocking_input = false
	%TriggerSleepy.is_armed = true
	planet.refresh_interact_focus()
	await %TriggerSleepy.interacted
	%TriggerSleepy.is_armed = false
	planet.refresh_interact_focus()
	_lock_input()
	await _prince(\"那么我提出的日落呢？\")
	await _overhead(\"小王子一旦提出一个问题，他是不会忘记的\")
	await _king(\"你会看到日落的，我会命令它。\")
	await _king(\"但根据我的统治科学，我要等到条件成熟的时候。\")
	await _prince(\"那要等到什么时候？\")
	await _overhead(\"小王子一旦提出一个问题，他是不会忘记的\")
	await _king(\"嗯...嗯...\")
	await _overhead(\"国王开始飞快地查厚厚的日历\")
	await _king(\"大约...今晚七点四十分左右！\")
	await _king(\"你将看到整个天空遵从我的命令！\")
	await _overhead(\"小王子又打了个哈欠，他有点厌烦了。\")
	is_blocking_input = false
	%TriggerSleepy.is_armed = true
	planet.refresh_interact_focus()
	await %TriggerSleepy.interacted
	%TriggerSleepy.is_armed = false
	planet.refresh_interact_focus()
	_lock_input()
	await _prince(\"我在这里没有事可做了，我要上路了。\")
	await _king(\"别走。\")
	await _overhead(\"国王不想错过刚刚得到的臣民\")
	await _king(\"别走！别走！我任命你为大臣！\")
	await _prince(\"什么大臣？\")
	await _king(\"司法大臣！\")
	await _prince(\"可是这儿没有人可以审判啊！\")
	await _king(\"这可难说。\")
	await _king(\"我还没有巡视过我的王国呢。\")
	await _king(\"我老了，这里放不下马车，走路又累人。\")
	await _prince(\"哦，可是我已经看过了！\")
	await _overhead(\"小王子转过身，又看了一眼星球的另一面。\")
	await _king(\"那么你就审判你自己吧！\")
	await _king(\"这是最难的事情。\")
	await _king(\"审判自己比审判别人难得多。\")
	await _king(\"如果你能正确地审判自己，你就是个真正有智慧的人。\")
	await _prince(\"我可以在任何地方审判自己，我不需要住在这里。\")
	await _king(\"嗯！嗯！\")
	await _king(\"我有理由相信我星球的某个地方有一只老耗子。\")
	await _king(\"我夜里听见它的声音。\")
	await _king(\"你可以审判那只老耗子。\")
	await _king(\"你可以不时地判处它死刑，这样它的生命就取决于你的审判。\")
	await _king(\"但为了节约，你每次都要赦免它。\")
	await _king(\"这里只有一只耗子。\")
	_mouse_verdict_count = 0
	%Mouse.restore_at_rest()
	is_blocking_input = false
	%TriggerSleepy.is_armed = true
	planet.refresh_interact_focus()
	await %TriggerSleepy.interacted
	%TriggerSleepy.is_armed = false
	planet.refresh_interact_focus()
	_lock_input()
	await _prince(\"我不喜欢判人死刑，我想我该走了。\")
	await _king(\"别走。\")
	await _prince(\"如果陛下希望被立刻服从...\")
	await _prince(\"应该给我一个合理的命令。\")
	await _prince(\"比如，命令我在一分钟之内离开。\")
	await _prince(\"看起来时机是成熟的...\")
	await _overhead(\"国王没有回答。\")
	await _overhead(\"小王子先是犹豫了一下，接着叹了口气，动身走了。\")
	await _king(\"我任命你为大使！\")
	await _overhead(\"国王急忙在他身后喊道，神气很是威严。\")
	%TriggerSleepy.interact_kind = WorldConstants.InteractKind.NONE
	planet.refresh_interact_focus()
	_lock_input()
	if skip_cinematics:
		player.modulate.a = 0.0
		_shell_node(&\"Dim\").color = Color(0, 0, 0, 1)
		_shell_node(&\"Epilogue\").text = \"325。\"
		departed.emit()
		return
	var shrink_tween := create_tween()
	shrink_tween.set_parallel(true)
	shrink_tween.tween_property(planet, \"scale\", Vector2(0.12, 0.12), LIFT_DURATION_SECONDS)
	shrink_tween.tween_property(player, \"modulate:a\", 0.0, LIFT_DURATION_SECONDS)
	await shrink_tween.finished
	var dim_tween := create_tween()
	dim_tween.tween_property(
			_shell_node(&\"Dim\"), \"color:a\", 1.0, DEPARTURE_BLACKOUT_SECONDS
	)
	_shell_node(&\"Music\").fade_out(DEPARTURE_BLACKOUT_SECONDS)
	await dim_tween.finished
	_shell_node(&\"Epilogue\").text = \"325。\"
	await _wait(EPILOGUE_HOLD_SECONDS)
	departed.emit()


func speak_approach_order() -> void:
	if not is_processing():
		return
	_last_player_facing_king = _player_is_facing_king()
	while is_blocking_player_input():
		await get_tree().process_frame
	if not %TriggerKingOrder.player_is_inside:
		return
	await _speak_king_facing_order(\"我命令你靠近我！\")


func _process(_delta: float) -> void:
	if is_blocking_player_input() or not %TriggerKingOrder.player_is_inside:
		_last_player_facing_king = _player_is_facing_king()
		return
	var player_is_facing_king: bool = _player_is_facing_king()
	if player_is_facing_king == _last_player_facing_king:
		return
	_last_player_facing_king = player_is_facing_king
	await _speak_king_facing_order(
			\"我命令你靠近我！\" if player_is_facing_king else \"我命令你走向远处！\"
	)


func _speak_king_facing_order(text: String) -> void:
	_lock_input()
	last_king_facing_order_text = text
	await _king(text)
	is_blocking_input = false


func _player_is_facing_king() -> bool:
	var king_is_to_the_left: bool = %King.global_position.x < player.global_position.x
	return player.flip_h == king_is_to_the_left


func _king(text: String) -> void:
	%King.frame = 1
	await _line(KING_SPEAKER, text, king_portrait)
	%King.frame = 0
"

