[sub_resource type="GDScript" id="GDScript_mouse"]
script/source = "extends SurfaceProp

const REST_OFFSET := Vector2(0, -7)
const IDLE_FRAME_COUNT := 2
const RUN_FRAME_START := 2
const RUN_FRAME_COUNT := 2
const IDLE_FRAMES_PER_SECOND := 2.0
const RUN_FRAMES_PER_SECOND := 10.0
const FLEE_ARC := 0.9
const FLEE_DURATION_SECONDS := 0.45

var _anim_time := 0.0
var _is_fleeing := false
var _motion_tween: Tween
var _rest_rotation := 0.0


func _ready() -> void:
	super._ready()
	interacted.connect(play_ambient_one_shot)
	_rest_rotation = rotation
	offset = REST_OFFSET
	hframes = 4
	frame = 0


func _process(delta: float) -> void:
	_anim_time += delta
	if _is_fleeing:
		frame = RUN_FRAME_START + int(_anim_time * RUN_FRAMES_PER_SECOND) % RUN_FRAME_COUNT
		return
	flip_h = global_position.x > owner.apex_global_position().x
	frame = int(_anim_time * IDLE_FRAMES_PER_SECOND) % IDLE_FRAME_COUNT


func play_ambient_one_shot() -> void:
	$Squeak.play()
	if _motion_tween != null:
		_motion_tween.kill()
	offset = REST_OFFSET
	_motion_tween = create_tween()
	_motion_tween.tween_property(self, \"offset\", REST_OFFSET + Vector2(0, -3), 0.06)
	_motion_tween.tween_property(self, \"offset\", REST_OFFSET, 0.10)


func run_away() -> void:
	_is_fleeing = true
	_anim_time = 0.0
	is_armed = false
	flip_h = false
	if _motion_tween != null:
		_motion_tween.kill()
	_motion_tween = create_tween()
	_motion_tween.set_trans(Tween.TRANS_QUAD)
	_motion_tween.set_ease(Tween.EASE_IN)
	_motion_tween.tween_property(self, \"rotation\", rotation + FLEE_ARC, FLEE_DURATION_SECONDS)
	_motion_tween.parallel().tween_property(self, \"modulate:a\", 0.0, FLEE_DURATION_SECONDS)
	_motion_tween.tween_callback(func() -> void:
		visible = false
		is_consumed = true
	)


func restore_at_rest() -> void:
	if _motion_tween != null:
		_motion_tween.kill()
		_motion_tween = null
	_is_fleeing = false
	_anim_time = 0.0
	rotation = _rest_rotation
	offset = REST_OFFSET
	modulate.a = 1.0
	visible = true
	is_consumed = false
	is_armed = true
	frame = 0
"

