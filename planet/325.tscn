[sub_resource type="GDScript" id="GDScript_story"]
script/source = "extends PlanetStory
## 325 号小行星：背面降落，路上可点环境；觐见时对上现有国王对话（无日落）。

var has_overheard_distant_sentencing: bool = false


func _prepare_start() -> void:
	player.move_speed_scale = 0.65
	player.modulate.a = 1.0
	has_overheard_distant_sentencing = false
	set_process(false)


func _play_story() -> void:
	await _fade_in_from_black()
	await _overhead(\"325\")
	player.can_move_left = true
	player.can_move_right = true
	is_blocking_input = false
	has_finished_opening = true
	await _await_king()

func _await_king() -> void:
	await %KingTrigger1.player_entered
	await _line(
			DialogueCatalog.KING_SPEAKER,
			\"啊，来了一个臣民\",
			DialogueCatalog.KING_PORTRAIT
	)
	_end_dialogue()
	is_blocking_input = false
"

