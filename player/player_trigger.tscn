[gd_scene format=3 uid="uid://cplyrtrgscn1"]

[sub_resource type="GDScript" id="GDScript_player_trigger"]
script/source = "extends Area2D
## 玩家邻近检测：脚底 Area 与本触发器重叠即视为进入草地、可交互范围或日落。

@export var kind: WorldConstants.TriggerKind = WorldConstants.TriggerKind.INTERACT
@export var radius: float = WorldConstants.INTERACT_RANGE_PX:
	set(value):
		radius = value
		if not is_node_ready():
			await ready
		(%CollisionShape2D.shape as CircleShape2D).radius = radius


func hosted_surface_prop() -> SurfaceProp:
	return get_parent() as SurfaceProp
"

[sub_resource type="CircleShape2D" id="CircleShape2D_trigger"]
resource_local_to_scene = true
radius = 16.0

[node name="PlayerTrigger" type="Area2D"]
collision_layer = 2
collision_mask = 0
monitoring = false
monitorable = true
input_pickable = false
script = SubResource("GDScript_player_trigger")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
unique_name_in_owner = true
shape = SubResource("CircleShape2D_trigger")
